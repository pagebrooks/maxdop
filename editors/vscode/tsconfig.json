{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    // The extension host runs VS Code's own Node (see mise.toml). ES2022 is what
    // Node 18+ handles without a downlevel pass.
    "target": "es2022",
    "lib": ["es2022"],
    "outDir": "out",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
